# Preferred backend base URL used by src/main/config.ts
CT_BACKEND_URL=http://127.0.0.1:4001

# Dist/installer builds generate .env.runtime from CT_BACKEND_URL (or BACKEND_URL)
# so packaged EXE can resolve backend URL without falling back to localhost.

# Optional legacy alias (used only if CT_BACKEND_URL is empty)
# BACKEND_URL=http://127.0.0.1:4001

# Optional runtime flags
# NODE_ENV=development

# Dev server URL is set by npm script in development, usually no need to set it manually
# VITE_DEV_SERVER_URL=http://localhost:5173

# Sentry DSN configuration for error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional. KLIPY key for the composer's GIF button. Leave it unset and the
# button is not rendered at all -- the composer stays exactly as it was.
# Free key: https://klipy.com/developers
# A test key allows 100 calls/hour; a production key (requested from the same
# dashboard once you have integrated) is unlimited.
#
# Read by the MAIN process only, and never sent to the renderer. KLIPY takes the
# key as a URL PATH SEGMENT, so a renderer-side fetch would hand it to Sentry:
# the Breadcrumbs integration records fetch URLs verbatim and attaches them to
# unrelated error reports. Main does the fetch and returns only the GIF rows.
# (This replaces CT_TENOR_API_KEY -- Google shut the Tenor API down on
# 2026-06-30, so that integration cannot work at all any more.)
# CT_KLIPY_API_KEY=
